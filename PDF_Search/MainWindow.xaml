<Window x:Class="PDF_Search.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PDF_Search"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="0,0,0,-6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBox x:Name="TBWord" HorizontalAlignment="Stretch" Margin="10,10,0,0" TextWrapping="Wrap" Text="Word" VerticalAlignment="Top" Height="26" Grid.Row="0" Grid.Column="0"/>
        <TextBox x:Name="TBPath" HorizontalAlignment="Stretch" Margin="10,10,0,0" TextWrapping="Wrap" Text="FilePath" VerticalAlignment="Top" Height="26" MouseDoubleClick="TBPath_DoubleClick" Grid.Row="0" Grid.Column="1"/>
        <Button Content="Start Search" HorizontalAlignment="Stretch" Margin="10,10,10,0" VerticalAlignment="Center" Click="Button_Click" Grid.Row="0" Grid.Column="2"/>
        <ListBox x:Name="LBPaths" Margin="10,10,10,10" MouseDoubleClick="LBPaths_DoubleClick" Grid.Row="1" Grid.ColumnSpan="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        <ProgressBar Name="Progressbar" Margin="10,10,10,10" Value="0" Visibility="Visible" Grid.Row="2" Grid.ColumnSpan="3" HorizontalAlignment="Stretch" Height="20"/>
    </Grid>
</Window>
