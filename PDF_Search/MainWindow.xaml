<Window x:Class="PDF_Search.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PDF_Search"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="0,0,0,-6">
        <TextBox x:Name="TBWord" HorizontalAlignment="Left" Margin="10,10,0,0" TextWrapping="Wrap" Text="Word" VerticalAlignment="Top" Width="143" Height="26"/>
        <TextBox x:Name="TBPath" HorizontalAlignment="Left" Margin="177,10,0,0" TextWrapping="Wrap" Text="FilePath" VerticalAlignment="Top" Width="470" Height="26" MouseDoubleClick="TBPath_DoubleClick"/>
        <Button  Content="Start Search" HorizontalAlignment="Left" Margin="668,13,0,0" VerticalAlignment="Top" Click="Button_Click" Width="94"/>
        <ListBox x:Name="LBPaths" Margin="10,61,10,49" MouseDoubleClick="LBPaths_DoubleClick"/>
        <ProgressBar Name="Progressbar" Margin="10,396,10,10" Value="0" Visibility="Visible"/>

    </Grid>
</Window>
